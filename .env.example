# Aucune valeur ici. Copier en .env.local et remplir.
# .env.local reste dans .gitignore.

# Génération des textes d'interprétation (surcouche optionnelle : le produit
# fonctionne sans, avec les gabarits déterministes).
ANTHROPIC_API_KEY=

# Persistance des lectures (optionnelle en développement).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paiement — hors périmètre de cette session.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Envoi du rapport — hors périmètre de cette session.
RESEND_API_KEY=
